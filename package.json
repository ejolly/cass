{
  "name": "cass",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": {
    "cassa": "src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/cassa",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit --project cassa/tsconfig.json",
    "check": "bun run lint && bun run typecheck && bun test"
  },
  "dependencies": {
    "@clack/prompts": "^0.10",
    "cac": "^6",
    "cli-table3": "^0.6",
    "consola": "^3",
    "ky": "^1",
    "kysely": "^0.28",
    "kysely-bun-sqlite": "^0.3",
    "p-limit": "^6",
    "papaparse": "^5",
    "smol-toml": "^1",
    "ts-pattern": "^5",
    "zod": "^3"
  },
  "workspaces": ["cassa"],
  "devDependencies": {
    "@biomejs/biome": "^1",
    "@types/bun": "^1",

    "@types/papaparse": "^5",
    "typescript": "^5"
  }
}
